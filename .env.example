# qr (default) atau pairing
AUTH_METHOD=qr

# Wajib jika menggunakan pairing; format 628...
BOT_NUMBER=

# Daftar key Gemini, dipisahkan dengan koma. Bot akan berganti ke key berikutnya jika menerima error 429.
# Dengan satu key, isi hanya satu nilai. Jangan simpan key asli di repository.
GEMINI_API_KEYS=

# Kompatibilitas untuk satu key; gunakan GEMINI_API_KEYS untuk rotasi otomatis.
GEMINI_API_KEY=

# Model dan basis URL Gemini OpenAI-compatible.
# Model stabil hemat untuk chat dan analisis gambar.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Koneksi Supabase untuk menyimpan profil nama dan gender pengguna.
# Gunakan service_role key, bukan anon key, dan jangan pernah menyimpan nilainya di GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin utama yang boleh memakai chat pribadi bot.
# Boleh ditulis 235656601194672 atau [235656601194672]; karakter selain angka otomatis diabaikan.
# Jika kosong, seluruh chat pribadi akan diabaikan demi keamanan.
# ADMIN_LID diprioritaskan. PRIVATE_ALLOWED_LID tetap didukung sebagai fallback lama.
ADMIN_LID=235656601194672
PRIVATE_ALLOWED_LID=235656601194672

# Debug sender JID/LID otomatis; ubah ke false setelah diagnosis selesai.
DEBUG_SENDER_IDENTITY=true

# Zona waktu bot. Default yang direkomendasikan untuk Indonesia barat.
BOT_TIMEZONE=Asia/Jakarta

# Opsional untuk fitur pencarian internet.
TAVILY_API_KEY=

# Untuk fitur cek link. VirusTotal dipakai untuk pemeriksaan keamanan.
# Jina Reader dipakai untuk mengambil isi halaman; key Jina opsional untuk batas lebih tinggi.
# Jangan simpan key asli di repository.
VIRUSTOTAL_API_KEY=
JINA_API_KEY=

# Opsional: override path audio akhir pekan. Default membaca aset dari repository GitHub.
# WEEKEND_AUDIO_SATURDAY_PATH=
# WEEKEND_AUDIO_SUNDAY_PATH=

# Opsional untuk perintah !tempat. Buat key gratis di https://myprojects.geoapify.com/
# Jangan simpan key asli di repository atau Supabase.
GEOAPIFY_API_KEY=

# Awalan perintah bot.
PREFIX=!

# Upscaler foto HD opsional. Model boleh public, API key wajib disimpan sebagai secret Railway.
DEAPI_ENABLED=true
DEAPI_MODEL=RealESRGAN_x4
DEAPI_MAX_LONG_SIDE=1440
DEAPI_DAILY_REQUEST_LIMIT=10
# Jangan simpan API key asli di repository.
DEAPI_API_KEY=

ADMIN_LID=235656601194672

DEBUG_SENDER_IDENTITY=true
