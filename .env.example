# qr (default) atau pairing
AUTH_METHOD=qr

# Wajib jika menggunakan pairing; format 628...
BOT_NUMBER=

# Daftar key Groq, dipisahkan dengan koma. Bot akan berganti ke key berikutnya jika menerima error 429.
# Dengan satu key, isi hanya satu nilai. Jangan simpan key asli di repository.
GROQ_API_KEYS=

# Kompatibilitas lama untuk satu key; gunakan GROQ_API_KEYS untuk rotasi otomatis.
GROQ_API_KEY=

# Model dan basis URL Groq untuk Chat Completions.
# Model chat utama. Pengaturan ini dibaca dari Railway Variables.
GROQ_MODEL=llama-3.1-8b-instant
# Opsional: model khusus perintah !gambar. Pesan teks biasa memakai GROQ_MODEL.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Koneksi Supabase untuk menyimpan profil nama dan gender pengguna.
# Gunakan service_role key, bukan anon key, dan jangan pernah menyimpan nilainya di GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Satu-satunya LID yang boleh chat pribadi dengan bot.
# Boleh ditulis 235656601194672 atau [235656601194672]; karakter selain angka otomatis diabaikan.
# Jika kosong, seluruh chat pribadi akan diabaikan demi keamanan.
PRIVATE_ALLOWED_LID=

# Zona waktu bot. Default yang direkomendasikan untuk Indonesia barat.
BOT_TIMEZONE=Asia/Jakarta

# Opsional untuk fitur pencarian internet.
TAVILY_API_KEY=

# Untuk fitur cek link. VirusTotal dipakai untuk pemeriksaan keamanan.
# Jina Reader dipakai untuk mengambil isi halaman; key Jina opsional untuk batas lebih tinggi.
# Jangan simpan key asli di repository.
VIRUSTOTAL_API_KEY=
JINA_API_KEY=

# Opsional untuk perintah !tempat. Buat key gratis di https://myprojects.geoapify.com/
# Jangan simpan key asli di repository atau Supabase.
GEOAPIFY_API_KEY=

# Awalan perintah bot.
PREFIX=!
