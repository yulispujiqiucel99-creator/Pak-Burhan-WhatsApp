# qr (default) atau pairing
AUTH_METHOD=qr

# Wajib jika menggunakan pairing; format 628...
BOT_NUMBER=

# Buat key di Groq Console lalu simpan sebagai Railway Variable.
GROQ_API_KEY=

# Model dan basis URL Groq untuk Chat Completions.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Satu-satunya LID yang boleh chat pribadi dengan bot.
# Boleh ditulis 235656601194672 atau [235656601194672]; karakter selain angka otomatis diabaikan.
# Jika kosong, seluruh chat pribadi akan diabaikan demi keamanan.
PRIVATE_ALLOWED_LID=

# Zona waktu bot. Default yang direkomendasikan untuk Indonesia barat.
BOT_TIMEZONE=Asia/Jakarta

# Opsional untuk fitur pencarian internet.
TAVILY_API_KEY=

# Awalan perintah bot.
PREFIX=!
