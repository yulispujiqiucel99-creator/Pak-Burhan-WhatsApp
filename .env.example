# Isi di Railway Variables / file .env lokal
# Jangan commit file .env berisi key asli

BOT_NUMBER=

# qr (default) atau pairing
AUTH_METHOD=qr

# Buat key di Google AI Studio lalu simpan sebagai Railway Variable.
GEMINI_API_KEY=

# Model Gemini yang dipakai bot.
GEMINI_MODEL=gemini-2.5-flash

TAVILY_API_KEY=

PREFIX=!
